# Required for independent production operation
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/BUK_DB
DATABASE_SSL=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PUBLIC_APP_URL=https://your-buk-domain.example
FRONTEND_ORIGINS=https://your-buk-domain.example
PORT=10000

# Persistent upload directory (attach a persistent disk to this path on Render)
STORAGE_DIR=/var/data/buk-uploads
MAX_UPLOAD_MB=80

# Optional: BUK AI, transcription, and translation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: phone invitations via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER_ID=

# Optional: forgot-password emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional separate frontend (leave empty for the same-origin deployment)
VITE_API_BASE_URL=
